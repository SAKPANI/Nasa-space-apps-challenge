{
  "colors": {
    "background": "#14214D",
    "primary": "#006A4E",
    "primary-light": "#66CBAA",
    "accent": "#FFCE00",
    "accent-light": "#FFEC70",
    "danger": "#D21034",
    "danger-light": "#FF6B71",
    "white": "#FFFFFF",
    "globe": "#1E88C9",
    "onSurface": "#FFFFFF",
    "muted": "#94A3B8",
    "glass": "rgba(20, 33, 77, 0.72)",
    "glass-border": "rgba(255, 255, 255, 0.15)",
    "glass-border-hover": "rgba(255, 206, 0, 0.5)"
  },
  "typography": {
    "fontFamilyTitle": "'Space Grotesk', sans-serif",
    "fontFamilyBody": "'Inter', sans-serif",
    "fontFamilyMono": "'JetBrains Mono', monospace",
    "titleWeight": 700,
    "titleSize": "2.5rem",
    "titleLetterSpacing": "0.08em",
    "bodySize": "1rem",
    "monoSize": "0.9rem"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "soft": "0 4px 16px rgba(0, 0, 0, 0.3)",
    "glass": "0 8px 32px 0 rgba(0, 0, 0, 0.4)",
    "glow": "0 0 16px rgba(255, 206, 0, 0.35)",
    "glow-accent": "0 0 20px rgba(255, 206, 0, 0.45)",
    "glow-primary": "0 0 16px rgba(102, 203, 170, 0.35)",
    "glow-cyan": "0 0 16px rgba(30, 136, 201, 0.4)"
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "600ms"
    },
    "easing": {
      "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
      "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
}
